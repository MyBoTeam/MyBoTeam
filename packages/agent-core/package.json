{
  "name": "@myboteam/agent-core",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./daemon": {
      "import": "./src/daemon/index.ts",
      "types": "./src/daemon/index.ts"
    },
    "./ipc/types.js": {
      "import": "./src/ipc/types.ts",
      "types": "./src/ipc/types.ts"
    },
    "./ipc/models/*.js": {
      "import": "./src/ipc/models/*.ts",
      "types": "./src/ipc/models/*.ts"
    },
    "./storage/migrations": {
      "import": "./src/storage/migrations/index.ts",
      "types": "./src/storage/migrations/index.ts"
    },
    "./storage/seeds": {
      "import": "./src/storage/seeds/index.ts",
      "types": "./src/storage/seeds/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "check": "biome check --write && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@myboteam/types": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
