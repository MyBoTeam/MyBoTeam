{
  "name": "@myboteam/daemon",
  "version": "0.1.0",
  "private": true,
  "description": "MyBoTeam background daemon process",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup && node scripts/write-dist-package-type.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "biome check --write . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "exit 0",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "clean": "node -e \"import('fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@myboteam/agent-core": "workspace:*",
    "@opencode-ai/sdk": "1.16.2",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "pino": "^10.3.1",
    "sql.js": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "^4.0.17",
    "@vitest/coverage-v8": "^4.1.0"
  }
}
