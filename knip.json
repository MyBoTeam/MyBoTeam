{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/agent-core": {
      "entry": ["src/index.ts", "src/common.ts", "src/types/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts", "src/preload/index.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "apps/web": {
      "entry": ["src/client/main.tsx"],
      "project": ["src/client/**/*.ts", "src/client/**/*.tsx"]
    },
    "apps/daemon": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [],
  "ignoreBinaries": [],
  "exclude": ["duplicates"]
}
