{
  "name": "myboteam",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "check": "biome check --no-errors-on-unmatched .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1"
  }
}
